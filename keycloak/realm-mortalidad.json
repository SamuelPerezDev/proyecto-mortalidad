{
  "id": "mortalidad",
  "realm": "mortalidad",
  "enabled": true,
  "sslRequired": "external",
  "roles": {
    "realm": [
      {
        "name": "realm-admin",
        "description": "Rol de administrador del realm",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": ["realm-admin"]
    }
  ],
  "clients": [
    {
      "clientId": "mortalidad-api",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "webOrigins": ["*"],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "false"
      }
    }
  ]
}
